<local:ArticleViewerPageBase
    x:Class="WikiViewer.Uwp.Pages.ArticleViewerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:WikiViewer.Uwp.Pages"
    xmlns:reader="using:WikiViewer.Uwp.Controls"
    Background="Transparent">
    <Page.Resources>
        <Storyboard x:Name="FadeInAnimation">
            <DoubleAnimation Storyboard.TargetName="LoadingOverlay" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.250" EnableDependentAnimation="True"/>
        </Storyboard>
        <Storyboard x:Name="FadeOutAnimation">
            <DoubleAnimation Storyboard.TargetName="LoadingOverlay" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.350" EnableDependentAnimation="True"/>
        </Storyboard>
    </Page.Resources>
    <Grid>
        <reader:WikiBrowser x:Name="ArticleDisplayWebView"/>
        <reader:NativeArticleView x:Name="NativeReader" Visibility="Collapsed"/>
        <Grid x:Name="TitleBarBackground" VerticalAlignment="Top" Style="{StaticResource PageTitleBarGridStyle}" Margin="0,0,15,0">
            <TextBlock x:Name="ArticleTitle" Style="{StaticResource PageTitleBarTextStyle}" TextWrapping="Wrap"/>
        </Grid>
        <CommandBar VerticalAlignment="Bottom" Background="{ThemeResource PageTitleBarAcrylicBrush}" Margin="0,0,15,0">
            <CommandBar.Content>
                <TextBlock x:Name="LastUpdatedText" Margin="12,0" VerticalAlignment="Center" FontSize="12" Opacity="0.8" TextTrimming="CharacterEllipsis" Visibility="Collapsed" ToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            </CommandBar.Content>
            <AppBarToggleButton x:Name="NativeReaderButton" Icon="Read" Label="Native reader (Preview)" Click="NativeReaderButton_Click"/>
            <AppBarButton x:Name="EditButton" Icon="Edit" Label="Edit" Click="EditButton_Click" Visibility="Collapsed"/>
            <AppBarButton x:Name="FavoriteButton" Icon="Favorite" Label="Add to Favourites" Click="FavoriteButton_Click"/>
            <AppBarButton x:Name="ShareButton" Icon="Share" Label="Share" Click="ShareButton_Click"/>
            <AppBarButton x:Name="ReloadPageButton" Icon="Refresh" Label="Reload page" Click="ReloadPageButton_Click"/>
            <AppBarButton x:Name="RefreshButton" Icon="Refresh" Label="Refresh Theme" Click="RefreshButton_Click"/>
            <CommandBar.SecondaryCommands>
                <AppBarButton x:Name="PrintButton" Icon="Print" Label="Print" Click="PrintButton_Click" IsEnabled="False"/>
            </CommandBar.SecondaryCommands>
        </CommandBar>
        <Grid x:Name="LoadingOverlay" Opacity="0" IsHitTestVisible="False" Background="{ThemeResource PageTitleBarAcrylicBrush}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <ProgressRing IsActive="True" Width="60" Height="60"/>
                <TextBlock x:Name="LoadingText" Text="Loading..." HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
        <Grid x:Name="VerificationPanel" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="12" Spacing="8">
                <TextBlock Text="Please complete the security check" Style="{ThemeResource TitleTextBlockStyle}"/>
                <TextBlock Text="The app will continue automatically once you finish." Style="{ThemeResource BodyTextBlockStyle}" TextWrapping="Wrap"/>
            </StackPanel>
            <reader:WikiBrowser x:Name="VerificationWebView" Grid.Row="1" />
        </Grid>
        <Canvas x:Name="PrintCanvas" Opacity="0" IsHitTestVisible="False"/>
    </Grid>
</local:ArticleViewerPageBase>

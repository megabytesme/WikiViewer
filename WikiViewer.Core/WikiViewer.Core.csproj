<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <WikitextParserVersion Condition="'$(WikitextParserVersion)' == ''">0.2.0</WikitextParserVersion>
    <DefineConstants Condition="'$(WikitextParserVersion)' != '0.0.1'">$(DefineConstants);WIKITEXT_EXTENDED</DefineConstants>
    <DefineConstants Condition="'$(WikitextParserVersion)' != '0.0.1' And '$(WikitextParserVersion)' != '0.1.0'">$(DefineConstants);WIKITEXT_CONFIGURABLE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3"/>
    <PackageReference Include="HtmlAgilityPack" Version="1.12.2"/>
    <PackageReference Include="WikitextParser" Version="$(WikitextParserVersion)"/>
  </ItemGroup>
</Project>
